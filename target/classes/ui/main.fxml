<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.canvas.Canvas?>
<BorderPane fx:controller="weighttracker.ui.MainController"
            stylesheets="@styles.css"
            xmlns:fx="http://javafx.com/fxml">
    <top>
        <VBox spacing="6" styleClass="header">
            <HBox spacing="10" styleClass="header-row">
                <Label fx:id="titleLabel" text="Weight Tracker" styleClass="title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="languageLabel" text="Språk" styleClass="section-label"/>
                <ComboBox fx:id="languageBox" prefWidth="140.0" styleClass="language-box"/>
            </HBox>
            <Region styleClass="title-accent"/>
            <Label fx:id="subtitleLabel"
                   text="Ange din kroppsvikt och dina personliga rekord (1RM eller reps) för att få nivåer och färgkodad feedback."
                   wrapText="true"
                   styleClass="subtitle"/>
        </VBox>
    </top>
    <center>
        <HBox spacing="24" styleClass="content">
            <VBox spacing="14" styleClass="input-pane">
                <HBox spacing="10" styleClass="gender-row">
                    <Label fx:id="tableLabel" text="Kön" styleClass="section-label"/>
                    <ComboBox fx:id="genderBox" prefWidth="180.0"/>
                </HBox>
                <GridPane hgap="12" vgap="10" styleClass="card input-card">
                    <columnConstraints>
                        <ColumnConstraints minWidth="160"/>
                        <ColumnConstraints prefWidth="190" maxWidth="220" hgrow="NEVER"/>
                    </columnConstraints>
                    <Label fx:id="bodyWeightLabel" text="Kroppsvikt (kg)" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="bodyWeightField" promptText="t.ex. 82,5" styleClass="input-field" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label fx:id="squatLabel" text="Knäböj 1RM (kg)" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="squatField" promptText="t.ex. 140" styleClass="input-field" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label fx:id="benchLabel" text="Bänkpress 1RM (kg)" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="benchField" promptText="t.ex. 95" styleClass="input-field" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label fx:id="cleanLabel" text="Frivändning 1RM (kg)" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="cleanField" promptText="t.ex. 80" styleClass="input-field" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    <Label fx:id="chinsLabel" text="Chins (max reps)" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="chinsField" promptText="t.ex. 12" styleClass="input-field" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    <Label fx:id="brutalLabel" text="Brutalbänk (max reps)" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <TextField fx:id="brutalBenchField" promptText="t.ex. 18" styleClass="input-field" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                    <Label fx:id="dipsLabel" text="Dips (max reps)" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <TextField fx:id="dipsField" promptText="t.ex. 22" styleClass="input-field" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                    <Label fx:id="cooperLabel" text="Cooper (min)" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                    <HBox spacing="8" GridPane.rowIndex="7" GridPane.columnIndex="1">
                        <ComboBox fx:id="cooperMinutesBox" prefWidth="90.0"/>
                        <Label text=":" styleClass="time-separator"/>
                        <ComboBox fx:id="cooperSecondsBox" prefWidth="90.0"/>
                </HBox>
            </GridPane>
                <HBox spacing="10">
                    <Button fx:id="calculateButton" text="Beräkna nivåer" onAction="#onCalculate" styleClass="primary-button"/>
                    <Button fx:id="clearButton" text="Rensa fält" onAction="#onClearFields" styleClass="secondary-button"/>
                    <Button fx:id="undoClearButton" text="Ångra rensa" onAction="#onUndoClear" styleClass="secondary-button"/>
                </HBox>
                <Label fx:id="statusLabel" styleClass="status-label"/>
            </VBox>
            <VBox spacing="12" styleClass="results-pane" HBox.hgrow="ALWAYS">
                <HBox spacing="10" styleClass="results-header">
                    <Label fx:id="resultsTitle" text="Resultat" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="resultsButton" text="Resultat" onAction="#onShowResults" styleClass="secondary-button"/>
                    <Button fx:id="tableButton" text="Tabell" onAction="#onShowTable" styleClass="secondary-button"/>
                    <Button fx:id="radarButton" text="Spindelnät" onAction="#onShowRadar" styleClass="secondary-button"/>
                    <Button fx:id="weightTableButton" text="Alla nivåer" onAction="#onShowWeightTable" styleClass="secondary-button"/>
                </HBox>
                <StackPane styleClass="results-surface" VBox.vgrow="ALWAYS">
                    <ListView fx:id="resultsList" styleClass="results-list" StackPane.alignment="TOP_LEFT"/>
                    <TableView fx:id="levelTable" styleClass="level-table" visible="false" managed="false"/>
                    <TableView fx:id="weightTable" styleClass="level-table" visible="false" managed="false"/>
                    <VBox fx:id="radarPane" styleClass="radar-pane" visible="false" managed="false">
                        <Canvas fx:id="radarCanvas"/>
                    </VBox>
                </StackPane>
            </VBox>
        </HBox>
    </center>
</BorderPane>
