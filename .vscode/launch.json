{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        

        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "Main",
            "request": "launch",
            "mainClass": "weighttracker.Main",
            "projectName": "weight-tracker",
            "preLaunchTask": "maven-compile",
            "classPaths": [
                "${workspaceFolder}/target/classes"
            ],
            "vmArgs": "--module-path \"${userHome}/.m2/repository/org/openjfx/javafx-base/25.0.2/javafx-base-25.0.2-mac-aarch64.jar:${userHome}/.m2/repository/org/openjfx/javafx-graphics/25.0.2/javafx-graphics-25.0.2-mac-aarch64.jar:${userHome}/.m2/repository/org/openjfx/javafx-controls/25.0.2/javafx-controls-25.0.2-mac-aarch64.jar:${userHome}/.m2/repository/org/openjfx/javafx-fxml/25.0.2/javafx-fxml-25.0.2-mac-aarch64.jar\" --add-modules javafx.controls,javafx.fxml --enable-native-access=javafx.graphics"
        }
    ]
}
